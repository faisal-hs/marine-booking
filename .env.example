APP_NAME="Marine Booking"
APP_ENV=local
APP_KEY=
# Must be false on any shared or production environment.
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Activity and category images are always stored on the "public" disk,
# whatever this is set to. Run `php artisan storage:link` once so they are
# reachable from the web.
FILESYSTEM_DISK=local
# Customer and provider notifications (push, SMS, e-mail and the in-app feed)
# are queued, so a queue worker MUST be running or they are never delivered:
#     php artisan queue:work
# A delivery that still fails after 3 tries lands in the failed_jobs table:
#     php artisan queue:failed      php artisan queue:retry all
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# Marine Booking
# =============================================================================

# --- OTP login (customers and providers) -------------------------------------
# These three values are the application defaults; they are listed so they can
# be tuned without reading the config.
OTP_LENGTH=4
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
# A fixed login code, for customers and providers alike, so you can sign in without
# reading an SMS. OTP_DEFAULT_CODE_ENABLED is the switch:
#   true  = on in ANY environment (e.g. a staging server with no SMS provider yet)
#   false = off everywhere, even locally (to test real codes)
#   blank = on only in local and testing
# This example leaves it BLANK on purpose, so copying it to a server never switches the
# fixed code on. Set it to true only where you really want it (a staging server with no
# SMS provider yet): leaving it on in production means anyone who knows a phone number
# can sign in as that person, and it is logged as a warning on every code.
OTP_DEFAULT_CODE=1234
OTP_DEFAULT_CODE_ENABLED=

# --- Reservations ------------------------------------------------------------
# Minutes a pending reservation holds capacity while waiting for payment.
RESERVATION_HOLD_MINUTES=15

# --- Payments ----------------------------------------------------------------
# Only the "mock" gateway exists today. It reports every payment as successful
# without charging anyone, so it is refused when APP_ENV=production: paying,
# refunding and the payment webhook answer 503 there until a real gateway is
# implemented (see config/payments.php). An unknown value is refused the same
# way. Local, testing and staging can use the mock freely.
PAYMENT_GATEWAY=mock
# Signs the mock gateway's webhooks. Local development only: the value below is
# public, so anything reachable from the internet must use its own long random
# secret.
MOCK_PAYMENT_WEBHOOK_SECRET=mock-webhook-secret-for-local-dev-only

# --- SMS ---------------------------------------------------------------------
# "log" writes messages to the log (safe locally). "taqnyat" uses the real
# gateway. Any other value is rejected with an error.
SMS_DRIVER=log
# TAQNYAT_API_KEY=
# TAQNYAT_SENDER=MarineBooking
# TAQNYAT_BASE_URL=https://api.taqnyat.sa/v1

# --- Push notifications (Firebase Cloud Messaging) ---------------------------
# "log" writes pushes to the log (safe locally). "http" uses real FCM. Any other
# value is rejected with an error.
FCM_DRIVER=log
# FCM_PROJECT_ID=
# A short-lived OAuth2 access token. It has to be refreshed by hand until
# service-account authentication is implemented (see HttpFcmGateway).
# FCM_ACCESS_TOKEN=

# --- Branding (optional) -----------------------------------------------------
# Paths relative to public/. Leave unset to show the text wordmark.
# BRANDING_LOGO_LIGHT=
# BRANDING_LOGO_DARK=
# BRANDING_FAVICON=

# --- Sanctum (optional) ------------------------------------------------------
# Prefix added to API tokens so secret scanners can recognise a leaked one.
# SANCTUM_TOKEN_PREFIX=
# Only needed for cookie-based SPA authentication, which this project does not
# use: its mobile clients authenticate with bearer tokens.
# SANCTUM_STATEFUL_DOMAINS=

# --- Bulk demo data (development only) ---------------------------------------
# php artisan db:seed --class="Database\Seeders\Bulk\BulkDatabaseSeeder" fills every
# table with a large, internally consistent data set. BULK_SEED_SCALE sizes it:
# 1 = about 1.3 million rows (370 MB in SQLite, about 75 seconds), 0.1 = a tenth, 0.01 = a smoke test. The same
# scale and seed always produce the same data. These seeders refuse to run in production.
BULK_SEED_SCALE=1
BULK_SEED_RANDOM=20261103

# --- Admin API ---------------------------------------------------------------
# Staff sign in at POST /api/v1/auth/admin/login and receive a bearer token for
# /api/v1/admin/*. Unlike customer and provider tokens it EXPIRES, after this many
# hours, because a staff token can approve, refund and moderate.
ADMIN_API_TOKEN_HOURS=8

# --- Monthly reservations per provider (development only) --------------------
# php artisan db:seed --class=ProviderMonthlyReservationSeeder gives every ACTIVE
# provider at least this many paid reservations in the current month. It counts what
# already exists and only adds the shortfall. Refuses to run in production.
PROVIDER_MONTH_MINIMUM=50

# --- Activity publishing -----------------------------------------------------
# Nobody approves an activity: the admin approves the provider account, and the provider publishes.
# true: a publish request makes the activity live at once. false: it becomes "ready" and stays
# hidden until the provider activates it.
ACTIVITY_AUTO_PUBLISH=true

# --- Currency ----------------------------------------------------------------
# The currency of every price, booking, payment and balance the platform creates (ISO 4217).
# Changing it affects only new records; nothing already stored is converted.
PLATFORM_CURRENCY=SAR

# --- Provider wallet ---------------------------------------------------------
# Days between the end of the trip day and the moment a booking's earnings can be withdrawn (0 = at once).
WALLET_SETTLEMENT_DELAY_DAYS=0
# The smallest withdrawal a provider may request (0 = any positive amount).
WALLET_MIN_WITHDRAWAL=0
# A fee kept from each withdrawal, in percent of the amount (0 = none).
WALLET_WITHDRAWAL_FEE_PERCENT=0
# How long a statement download link works, in minutes.
WALLET_STATEMENT_LINK_MINUTES=15

# --- Coupons ---------------------------------------------------------------
# A booking never costs less than this, however large the coupon (platform currency).
COUPON_MINIMUM_TOTAL=1
