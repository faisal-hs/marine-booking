APP_NAME="Marine Booking"
APP_ENV=local
APP_KEY=
# Must be false on any shared or production environment.
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Activity and category images are always stored on the "public" disk,
# whatever this is set to. Run `php artisan storage:link` once so they are
# reachable from the web.
FILESYSTEM_DISK=local
# Customer and provider notifications (push, SMS, e-mail and the in-app feed)
# are queued, so a queue worker MUST be running or they are never delivered:
#     php artisan queue:work
# A delivery that still fails after 3 tries lands in the failed_jobs table:
#     php artisan queue:failed      php artisan queue:retry all
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# Marine Booking
# =============================================================================

# --- OTP login (customers and providers) -------------------------------------
# These three values are the application defaults; they are listed so they can
# be tuned without reading the config.
OTP_LENGTH=4
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
# A fixed login code for LOCAL DEVELOPMENT AND TESTS ONLY, so you can sign in
# without reading an SMS. It is honoured only when APP_ENV is "local" or
# "testing" and never in production, but do not set it on any shared or public
# environment either.
OTP_DEFAULT_CODE=1234

# --- Reservations ------------------------------------------------------------
# Minutes a pending reservation holds capacity while waiting for payment.
RESERVATION_HOLD_MINUTES=15

# --- Payments ----------------------------------------------------------------
# WARNING: only the "mock" gateway exists today. It reports every payment as
# successful without charging anyone, so this application cannot take real
# payments yet and must not be exposed publicly as it is. Adding a real gateway
# is described in config/payments.php.
PAYMENT_GATEWAY=mock
# Signs the mock gateway's webhooks. Local development only: the value below is
# public, so anything reachable from the internet must use its own long random
# secret.
MOCK_PAYMENT_WEBHOOK_SECRET=mock-webhook-secret-for-local-dev-only

# --- SMS ---------------------------------------------------------------------
# "log" writes messages to the log (safe locally). "taqnyat" uses the real
# gateway. Any other value is treated as "taqnyat", so check the spelling.
SMS_DRIVER=log
# TAQNYAT_API_KEY=
# TAQNYAT_SENDER=MarineBooking
# TAQNYAT_BASE_URL=https://api.taqnyat.sa/v1

# --- Push notifications (Firebase Cloud Messaging) ---------------------------
# "log" writes pushes to the log (safe locally). "http" uses real FCM. Any other
# value is treated as "http", so check the spelling.
FCM_DRIVER=log
# FCM_PROJECT_ID=
# A short-lived OAuth2 access token. It has to be refreshed by hand until
# service-account authentication is implemented (see HttpFcmGateway).
# FCM_ACCESS_TOKEN=

# --- Branding (optional) -----------------------------------------------------
# Paths relative to public/. Leave unset to show the text wordmark.
# BRANDING_LOGO_LIGHT=
# BRANDING_LOGO_DARK=
# BRANDING_FAVICON=

# --- Sanctum (optional) ------------------------------------------------------
# Prefix added to API tokens so secret scanners can recognise a leaked one.
# SANCTUM_TOKEN_PREFIX=
# Only needed for cookie-based SPA authentication, which this project does not
# use: its mobile clients authenticate with bearer tokens.
# SANCTUM_STATEFUL_DOMAINS=
